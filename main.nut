/**
* Controls the generation and tracking of additional subsidies.
* This controller supplements OpenTTD's built-in subsidy generation. It periodically attempts to create subsidy offers while maintaining the configured limit on outstanding, unawarded offers generated by this script.
* Offers are shared between all companies, as with normal OpenTTD subsidies. Awarded or invalid offers are removed from the tracked list, allowing replacement offers to be generated.
*/
class ConfigurableSubsidiesController extends GSController
{
    /**
    * IDs of currently tracked, unawarded subsidy offers.
    *
    * This list only tracks offers created by this script. It does not include vanilla subsidies or offers created by other scripts.
    */
    managed_offers = [];

    /**
    * Game date on which the next generation check should occur.
    * A value of -1 indicates that the next check date has not yet been initialised.
    */
    next_check_date = -1;

    /**
    * Serialises the controller's state for saving.
    * @return Table containing the save-data version, tracked subsidy IDs, and next scheduled generation-check date.
    */
    function Save()
    {
        return
        {
            version = 1,
            managed_offers = this.managed_offers,
            next_check_date = this.next_check_date
        };
    }

    /**
    * Restores the controller's state from saved data.
    * Fields are checked before being read so that missing values do not cause errors when loading older save data.
    * @param version Version of the saved data.
    * @param data Table containing the previously saved controller state.
    */
    function Load(version, data)
    {
        if ("managed_offers" in data)
        {
            this.managed_offers = data.managed_offers;
        }

        if ("next_check_date" in data)
        {
            this.next_check_date = data.next_check_date;
        }
    }

    /**
    * Runs the controller's main scheduling loop.
    * Initialises the next check date if necessary, then periodically reconciles tracked offers and attempts to generate a replacement offer when the configured outstanding-offer target has not been reached.
    * At most one offer is attempted per generation interval.
    */
    function Start()
    {
        // Generate the first offer immediately when no generation date has been saved.
		if (this.next_check_date < 0)
		{
			this.ReconcileOffers();
			this.GenerateOffer();

			this.next_check_date = GSDate.GetCurrentDate() + this.GetIntervalDays();
		}

		// Main loop: reconcile offers and attempt to generate a new offer when the next check date is reached.
        while (true)
        {
            local today = GSDate.GetCurrentDate();

            if (today >= this.next_check_date)
            {
                this.ReconcileOffers();

                // Attempt to create at most one offer per interval.
                this.GenerateOffer();

                this.next_check_date = today + this.GetIntervalDays();
            }

            GSController.Sleep(10);
        }
    }

    /**
    * Calculates the configured generation interval in game days.
    * When use_weeks is enabled, the interval is converted to seven-day weeks. Otherwise, months are approximated as 30 days.
    * @return Number of game days between generation checks.
    */
    function GetIntervalDays()
    {
        local interval = GSController.GetSetting("generation_interval");
        local unit = GSController.GetSetting("use_weeks");

        if (interval < 1)
        {
            interval = 1;
        }

        // Unit 0 = months, unit 1 = weeks.
        if (unit == 1)
        {
            return interval * 7;
        }

        // Approximate months using an average calendar month.
        return interval * 30;
    }

    /**
    * Retrieves the configured maximum subsidy-route distance.
    * A value of zero disables the distance limit.
    * @return Maximum allowed Manhattan distance in tiles, or zero when routes are unrestricted by distance.
    */
    function GetMaxDistance()
    {
        return GSController.GetSetting("max_distance");
    }

    /**
    * Retrieves the configured target for outstanding offers.
    * @return Desired number of tracked, unawarded subsidy offers.
    */
    function GetTargetOffers()
    {
        local target = GSController.GetSetting("target_offers");

        if (target < 0)
        {
            target = 0;
        }

        return target;
    }

    /**
    * Removes invalid and already-awarded offers from the tracked list.
    * Offers that have expired or otherwise become invalid are also removed. Their expiry is controlled by OpenTTD's normal rules.
    */
    function ReconcileOffers()
    {
        local remaining = [];

        foreach (sid in this.managed_offers)
        {
            if (!GSSubsidy.IsValidSubsidy(sid))
            {
                continue;
            }

            if (GSSubsidy.IsAwarded(sid))
            {
                continue;
            }

            remaining.append(sid);
        }

        this.managed_offers = remaining;
    }

    /**
    * Attempts to generate one new subsidy offer if below the target.
    * Does nothing when the number of tracked outstanding offers has already reached the configured target.
    */
    function GenerateOffer()
    {
        local target = this.GetTargetOffers();

        // Do nothing if the target has already been reached.
        if (this.managed_offers.len() >= target)
        {
            return;
        }

        // Attempt to create only one offer this interval.
        this.TryCreateOffer();
    }

    /**
    * Searches available cargo types for a possible subsidy route.
    * Starts with a randomly selected cargo type and then tries the remaining cargo types until an offer is created or no suitable route can be found.
    * @return True if an offer was created and tracked; otherwise false.
    */
    function TryCreateOffer()
    {
        local cargoes = GSCargoList();

        if (cargoes.IsEmpty())
        {
            return false;
        }

        // Collect cargo IDs so each cargo can be tried if necessary.
        local cargo_ids = [];
        local cargo_id = cargoes.Begin();

        while (!cargoes.IsEnd())
        {
            cargo_ids.append(cargo_id);
            cargo_id = cargoes.Next();
        }

        if (cargo_ids.len() == 0)
        {
            return false;
        }

        // Start from a random cargo and try the others if necessary.
        local start = GSBase.RandRange(cargo_ids.len());

        for (local c = 0; c < cargo_ids.len(); c++)
        {
            local cargo = cargo_ids[(start + c) % cargo_ids.len()];

            if (this.TryCargo(cargo))
            {
                return true;
            }
        }

        return false;
    }

    /**
    * Searches for a valid subsidy route for a particular cargo type.
    * Potential sources include industries and towns that produced the cargo during the previous month. Potential destinations include industries that accept the cargo and towns affected by it.
    * Candidate pairs are sampled randomly, subject to the configured distance limit and the requirement that the route does not already have an existing subsidy offer.
    * @param cargo Cargo ID for which to search for a subsidy route.
    * @return True if a suitable offer was created and tracked; otherwise false.
    */
    function TryCargo(cargo)
    {
        local sources = [];
        local destinations = [];

        // Industries producing this cargo are potential sources.
        local industries = GSIndustryList();
        local iid = industries.Begin();

        while (!industries.IsEnd())
        {
            if (GSIndustry.GetLastMonthProduction(iid, cargo) > 0)
            {
                sources.append(
                {
                    type = GSSubsidy.SPT_INDUSTRY,
                    id = iid,
                    tile = GSIndustry.GetLocation(iid)
                });
            }

            if (GSIndustry.IsCargoAccepted(iid, cargo) == GSIndustry.CAS_ACCEPTED)
            {
                destinations.append(
                {
                    type = GSSubsidy.SPT_INDUSTRY,
                    id = iid,
                    tile = GSIndustry.GetLocation(iid)
                });
            }

            iid = industries.Next();
        }

        // Towns can produce cargo and accept town-effect cargoes.
        local towns = GSTownList();
        local tid = towns.Begin();

        while (!towns.IsEnd())
        {
            if (GSTown.GetLastMonthProduction(tid, cargo) > 0)
            {
                sources.append(
                {
                    type = GSSubsidy.SPT_TOWN,
                    id = tid,
                    tile = GSTown.GetLocation(tid)
                });
            }

            if (GSCargo.GetTownEffect(cargo) != GSCargo.TE_NONE)
            {
                destinations.append(
                {
                    type = GSSubsidy.SPT_TOWN,
                    id = tid,
                    tile = GSTown.GetLocation(tid)
                });
            }

            tid = towns.Next();
        }

        if (sources.len() == 0 || destinations.len() == 0)
        {
            return false;
        }

        local max_distance = this.GetMaxDistance();

        // Randomly sample possible pairs instead of building every possible route on potentially very large maps.
        local attempts = 0;
        local max_attempts = 500;

        while (attempts < max_attempts)
        {
            attempts++;

            local source = sources[GSBase.RandRange(sources.len())];
            local destination = destinations[GSBase.RandRange(destinations.len())];

            // A location cannot subsidise a route to itself.
            if (source.type == destination.type && source.id == destination.id)
            {
                continue;
            }

            local distance = GSTile.GetDistanceManhattanToTile(source.tile, destination.tile);

            if (max_distance != 0 && distance > max_distance)
            {
                continue;
            }

            if (this.RouteExists(cargo, source, destination))
            {
                continue;
            }

            return this.CreateAndTrack(cargo, source, destination);
        }

        return false;
    }

    /**
    * Checks whether a subsidy already exists for the specified route.
    * The comparison includes the cargo, source type and ID, and destination type and ID.
    * @param cargo Cargo ID for the proposed route.
    * @param source Table describing the proposed source location.
    * @param destination Table describing the proposed destination.
    *
    * @return True if a matching subsidy already exists; otherwise false.
    */
    function RouteExists(cargo, source, destination)
    {
        local list = GSSubsidyList();
        local sid = list.Begin();

        while (!list.IsEnd())
        {
            if (GSSubsidy.GetCargoType(sid) == cargo &&
                GSSubsidy.GetSourceType(sid) == source.type &&
                GSSubsidy.GetSourceIndex(sid) == source.id &&
                GSSubsidy.GetDestinationType(sid) == destination.type &&
                GSSubsidy.GetDestinationIndex(sid) == destination.id)
            {
                return true;
            }

            sid = list.Next();
        }

        return false;
    }

    /**
    * Creates a subsidy and tracks its ID if creation succeeds.
    * Takes a snapshot of existing subsidy IDs before creation, then identifies the newly created offer by comparing the subsidy list. Only valid, unawarded offers are added to managed_offers.
    * @param cargo Cargo ID for the subsidy.
    * @param source Table containing the source type, ID, and tile.
    * @param destination Table containing the destination type, ID, and tile.
    * @return True if the new offer was identified and tracked; otherwise false.
    */
    function CreateAndTrack(cargo, source, destination)
    {
        // Snapshot current subsidy IDs to identify the new offer.
        local before = {};
        local list = GSSubsidyList();
        local sid = list.Begin();

        while (!list.IsEnd())
        {
            before[sid] <- true;
            sid = list.Next();
        }

        local created = GSSubsidy.Create(cargo, source.type, source.id, destination.type, destination.id);

        if (!created)
        {
            return false;
        }

        local after = GSSubsidyList();
        sid = after.Begin();

        while (!after.IsEnd())
        {
            if (!(sid in before) && GSSubsidy.IsValidSubsidy(sid) && !GSSubsidy.IsAwarded(sid))
            {
                this.managed_offers.append(sid);
                return true;
            }

            sid = after.Next();
        }

        return false;
    }
}
